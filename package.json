{
  "name": "dsh-keep-notes",
  "version": "1.3.1",
  "description": "Keep-style notes, calendar todos, a GitHub-style activity heatmap and shared-folder sync in a DSH sidebar panel, with shared agent tools.",
  "license": "MIT",
  "author": "wiills <me@wiills.com>",
  "homepage": "https://github.com/wiills/dsh-keep-notes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiills/dsh-keep-notes.git"
  },
  "bugs": {
    "url": "https://github.com/wiills/dsh-keep-notes/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notes",
    "todo",
    "to-do",
    "todo-notes",
    "tasks",
    "memo",
    "sticky-notes",
    "calendar",
    "heatmap",
    "agent",
    "tools",
    "sync",
    "multilingual",
    "keep"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "README.en.md",
    "index.js",
    "host-store.js",
    "host-sync.js",
    "host-tools.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check host-store.js && node --check host-sync.js && node --check host-tools.js && node --check client.js && node scripts/build-client.mjs --check",
    "test": "node --test",
    "validate:index": "node scripts/validate-index.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
